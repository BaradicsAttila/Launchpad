<UserControl x:Class="Launch_Pad.View.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Launch_Pad.View"
			 xmlns:vm ="clr-namespace:Launch_Pad.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="1920">
	<UserControl.DataContext>
		<vm:TiltlebarVM/>
	</UserControl.DataContext>
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
			<Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition 
				Width="30"/>
			<ColumnDefinition 
				Width="100"/>
			<ColumnDefinition
				Width="1*"/>
			<ColumnDefinition 
				Width="30"/>
			<ColumnDefinition 
				Width="30"/>
			<ColumnDefinition 
				Width="30"/>
		</Grid.ColumnDefinitions>

		<Image 
			Grid.Column="0"
			Source="pack://application:,,,/Images/Lp_Ikon.png" 
			Height="20" 
			Width="20"/>
		<TextBlock 
			Grid.Column="1" 
			Text="Launchpad" 
			VerticalAlignment="Center" 
			Foreground="#cccccc" 
			FontSize="20" 
			FontWeight="Light"/>
		<Rectangle 
			Grid.Column="2" 
			Fill="Transparent"/>
        <Button
			Name="clsbtn"
			Command="{Binding clsbtnCommand}"
			Grid.Column="5"
			Content=""/>
		<Button
            Name="maximbtn"
            Command="{Binding maximbtnCommand}"
            Grid.Column="4"
            Content="{Binding MaximbtnContent}"/>
		<Button
            Name="minimbtn"
            Command="{Binding minimbtnCommand}"
            Grid.Column="3"
            Content=""/>
    </Grid>
</UserControl>
