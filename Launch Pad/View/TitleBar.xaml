<UserControl x:Class="Launch_Pad.View.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Launch_Pad.View"
			 xmlns:vm ="clr-namespace:Launch_Pad.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="70" d:DesignWidth="1920">
	<UserControl.DataContext>
		<vm:TiltlebarVM/>
	</UserControl.DataContext>
    <UserControl.Resources>
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
			<Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Background" Value="Transparent"/>
			<Setter Property="VerticalAlignment" Value="Top"/>
			<Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
		<Style x:Key="NoHoverButtonStyle" BasedOn="{StaticResource BaseButtonStyle}" TargetType="Button">
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="Transparent"/>
				</Trigger>
			</Style.Triggers>
		</Style>

	</UserControl.Resources>
	<Grid Background="#141419">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="20"/>
			<ColumnDefinition Width="40"/>
			<ColumnDefinition Width="15"/>
			<ColumnDefinition Width="200"/>
			<ColumnDefinition
				Width="1*"/>
			<ColumnDefinition 
				Width="45"/>
			<ColumnDefinition 
				Width="45"/>
			<ColumnDefinition 
				Width="45"/>
		</Grid.ColumnDefinitions>

		<Rectangle
			Grid.Column="0"
			Grid.ColumnSpan="4"
			Fill="#111116"/>

		<Button
			Style="{StaticResource NoHoverButtonStyle}"
			Width="auto"
			Height="30"
			Panel.ZIndex="1"
			PreviewMouseLeftButtonDown="Window_MouseLeftButtonDown"
			PreviewMouseMove="Window_MouseMove"
			MouseDoubleClick="TitleBar_MouseDoubleClick"
			PreviewMouseLeftButtonUp="Window_MouseLeftButtonUp"
			VerticalAlignment="Top"
			Margin="0 0 0 0"
			Grid.ColumnSpan="8"/>

		<Image
			Margin="0 15 0 0"
			Grid.Column="1"
			VerticalAlignment="Top"
			HorizontalAlignment="Left"
			Source="pack://application:,,,/Images/Lp_Ikon.png" 
			Height="40" 
			Width="40"/>
		<TextBlock
			Margin="0 15 0 0"
			Grid.Column="3"
			Text="LaunchPad" 
			Foreground="#cccccc" 
			FontSize="30"/>

		<Rectangle 
			Grid.Column="4" 
			Fill="Transparent"/>
        <Button
			Style="{StaticResource BaseButtonStyle}"
			Panel.ZIndex="2"
			Name="clsbtn"
			Command="{Binding clsbtnCommand}"
			Grid.Column="7"
			Content=""/>
		<Button
			Style="{StaticResource BaseButtonStyle}"
			Panel.ZIndex="2"
            Name="maximbtn"
            Command="{Binding maximbtnCommand}"
            Grid.Column="6"
            Content="{Binding MaximbtnContent}"/>
		<Button
			Style="{StaticResource BaseButtonStyle}"
			Panel.ZIndex="2"
            Name="minimbtn"
            Command="{Binding minimbtnCommand}"
            Grid.Column="5"
            Content=""/>
    </Grid>
</UserControl>
