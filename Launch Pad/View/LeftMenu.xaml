<UserControl x:Class="Launch_Pad.View.LeftMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Launch_Pad.View"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="200">
    <Grid>
		<Grid.RowDefinitions>
			<RowDefinition/>
			<RowDefinition/>
			<RowDefinition/>
			<RowDefinition/>
		</Grid.RowDefinitions>
		<Image 
			Source="pack://application:,,,/Images/Lp_Ikon.png" 
			Height="20" 
			Width="20"/>
		<TextBlock 
			Text="LaunchPad" 
			VerticalAlignment="Center" 
			Foreground="#cccccc" 
			FontSize="30" 
			FontWeight="Light"/>

	</Grid>
</UserControl>
