<UserControl x:Class="LaunchPad.View.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LaunchPad.View"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1365">
	<UserControl.Resources>
		<Style x:Key="PlayButtonStyle" TargetType="Button">
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Width" Value="200"/>
			<Setter Property="Height" Value="35"/>
			<Setter Property="FontSize" Value="20"/>
			<Setter Property="Foreground" Value="#CCCCCC"/>
			<Setter Property="Background" Value="Transparent"/>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="Transparent"/>
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="{x:Type Button}">
								<Border Background="{TemplateBinding Background}">
									<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Trigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="favoritblocks" TargetType="StackPanel">

		</Style>
		<DataTemplate x:Key="FavouriteCardTemplate">
			<Border Margin="10 0 10 0" Padding="5" Width="230" CornerRadius="5" Background="#1A1A1A" BorderThickness="1" BorderBrush="#222222">
				<StackPanel>
					<Image Source="{Binding Icon}"/>
					<Label Content="{Binding Name}" Foreground="#CCCCCC" FontSize="14"/>
					<Label Content="{Binding LastPlayedLabel}" Foreground="#CCCCCC" FontWeight="ExtraLight" FontSize="10"/>
					<Border CornerRadius="5" Background="#5A3BB2">
						<Button Style="{StaticResource PlayButtonStyle}">
							<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
								<TextBlock Text="" FontFamily="{StaticResource IconsFill}" VerticalAlignment="Center"/>
								<TextBlock Text=" Play"/>
							</StackPanel>
						</Button>
					</Border>
				</StackPanel>
			</Border>

		</DataTemplate>
	</UserControl.Resources>
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="405 "/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Border Background="#1F1F1F" CornerRadius="5">
			<StackPanel>
				<StackPanel.Resources>
					<Style TargetType="Image">
						<Setter Property="Stretch" Value="Fill"/>
					</Style>
				</StackPanel.Resources>
				<Grid Margin="10">
					<TextBlock Text=" Favourites" Foreground="#CCCCCC" FontSize="22"/>
					<TextBlock Text="View All" Foreground="#8A6BE2" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/>
				</Grid>
				<ItemsControl ItemsSource="{Binding Favourites}" ItemTemplate="{StaticResource FavouriteCardTemplate}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
				</ItemsControl>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>
