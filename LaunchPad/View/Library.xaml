          CommandParameter="{Binding}"/>
        <MenuItem Header="Change exe path..."
          Command="{Binding DataContext.ChangeExePathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
          CommandParameter="{Binding}"/>
        <Button x:Name="ExcludeToggleButton"
        Content="Exclude"
        Command="{Binding DataContext.ExcludeGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
        CommandParameter="{Binding}">
            <Button.Style>
                <Style TargetType="Button">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                            <Setter Property="Content" Value="Include"/>
