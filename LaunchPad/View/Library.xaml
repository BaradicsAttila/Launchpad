<UserControl x:Class="LaunchPad.View.Library"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LaunchPad.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
		<Button Content="★"
        Command="{Binding DataContext.ToggleFavouriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
        CommandParameter="{Binding}"/>
        <MenuItem Header="Exclude this"
          Command="{Binding DataContext.ExcludeGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
          CommandParameter="{Binding}"/>
        <MenuItem Header="Change exe path..."
          Command="{Binding DataContext.ChangeExePathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
          CommandParameter="{Binding}"/>
        <Button x:Name="ExcludeToggleButton"
        Content="Exclude"
        Command="{Binding DataContext.ExcludeGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
        CommandParameter="{Binding}">
            <Button.Style>
                <Style TargetType="Button">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                            <Setter Property="Content" Value="Include"/>
                            <Setter Property="Command" Value="{Binding DataContext.IncludeGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</UserControl>
