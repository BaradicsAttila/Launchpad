<UserControl x:Class="LaunchPad.View.LeftMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LaunchPad.View"
			 xmlns:vm ="clr-namespace:LaunchPad.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="235">

	<UserControl.Resources>
		<Style TargetType="RadioButton">
			<Setter Property="FontSize" Value="20"/>
			<Setter Property="Margin" Value="20 10 20 0"/>
			<Setter Property="Foreground" Value="#CCCCCC"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="RadioButton">
						<Border x:Name="BorderBg" Background="Transparent" CornerRadius="10">
							<ContentPresenter Margin="10 10"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="BorderBg" Property="Background" Value="#408A2BE2"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="Icons" TargetType="Run">
			<Setter Property="FontFamily" Value="{StaticResource IconsDef}"/>
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
					<Setter Property="FontFamily" Value="{StaticResource IconsFill}"/>
					<Setter Property="Foreground" Value="#8A6BE2"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="QuickLabel" TargetType="Label">
			<Setter Property="Foreground" Value="#CCCCCC"/>
			<Setter Property="FontSize" Value="12"/>
		</Style>
		<Style TargetType="WrapPanel">
			<Setter Property="Margin" Value="0 15 0 0"/>
		</Style>
		<Style x:Key="QImgB" TargetType="Border">
			<Setter Property="CornerRadius" Value="5"/>
			<Setter Property="Margin" Value="10 0 5 0"/>
			<Setter Property="Width" Value="30"/>
			<Setter Property="Height" Value="30"/>
		</Style>
	</UserControl.Resources>
	<Grid Background="#111119">
		<Grid.RowDefinitions>
			<RowDefinition Height="100*" MaxHeight="330"/>
			<RowDefinition Height="100*" MaxHeight="330"/>
			<RowDefinition Height="*" MinHeight="150"/>
			<RowDefinition Height="20"/>
		</Grid.RowDefinitions>
		<Rectangle Width="auto" Height="1px" Fill="#CCCCCC" VerticalAlignment="Top" Opacity="0.1"/>
		<ScrollViewer VerticalScrollBarVisibility="Hidden" >
			<StackPanel >
				<RadioButton x:Name="RBHome" GroupName="Menu" IsChecked="{Binding IsHomeSelected, Mode=TwoWay}">
					<TextBlock> <Run Style="{StaticResource Icons}"></Run> <Run></Run> Home</TextBlock>
				</RadioButton>
				<RadioButton x:Name="RBLibrary" GroupName="Menu" IsChecked="{Binding IsLibrarySelected, Mode=TwoWay}">
					<TextBlock> <Run Style="{StaticResource Icons}"></Run> <Run></Run> Library</TextBlock>
				</RadioButton>
				<RadioButton x:Name="RBStatistics" GroupName="Menu" IsChecked="{Binding IsStatisticsSelected, Mode=TwoWay}">
					<TextBlock> <Run Style="{StaticResource Icons}"></Run> <Run></Run> Statistics</TextBlock>
				</RadioButton>
				<RadioButton x:Name="RBMacros" GroupName="Menu" IsChecked="{Binding IsMacrosSelected, Mode=TwoWay}">
					<TextBlock> <Run Style="{StaticResource Icons}"></Run> <Run></Run> Macros</TextBlock>
				</RadioButton>
				<RadioButton x:Name="RBSettings" GroupName="Menu" IsChecked="{Binding IsSettingsSelected, Mode=TwoWay}">
					<TextBlock> <Run Style="{StaticResource Icons}"></Run> <Run></Run> Settings</TextBlock>
				</RadioButton>
			</StackPanel>
		</ScrollViewer>

		<Border Grid.Row="1" Background="#15151C" Margin="10 10 10 10" CornerRadius="10" BorderThickness="1" BorderBrush="#222222">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="auto"/>
					<RowDefinition Height="1*"/>
				</Grid.RowDefinitions>
				<TextBlock Text="Quick Launch" Foreground="#CCCCCC" Margin="10 10 10 0" FontSize="14"/>
				<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
					<StackPanel>
						<WrapPanel>
							<Border Style="{StaticResource QImgB}">
								<Image Source="/Resources/Images/Lp_Ikon.png"/>
							</Border>
							<Label Style="{StaticResource QuickLabel}" Content="1 Ring"/>
						</WrapPanel>
						<WrapPanel>
							<Border Style="{StaticResource QImgB}">
								<Image Source="/Resources/Images/Lp_Ikon.png"/>
							</Border>
							<Label Style="{StaticResource QuickLabel}" Content="2 Ring"/>
						</WrapPanel>
						<WrapPanel>
							<Border Style="{StaticResource QImgB}">
								<Image Source="/Resources/Images/Lp_Ikon.png"/>
							</Border>
							<Label Style="{StaticResource QuickLabel}" Content="3 Ring"/>
						</WrapPanel>
						<WrapPanel>
							<Border Style="{StaticResource QImgB}">
								<Image Source="/Resources/Images/Lp_Ikon.png"/>
							</Border>
							<Label Style="{StaticResource QuickLabel}" Content="4 Ring"/>
						</WrapPanel>
						<WrapPanel>
							<Border Style="{StaticResource QImgB}">
								<Image Source="/Resources/Images/Lp_Ikon.png"/>
							</Border>
							<Label Style="{StaticResource QuickLabel}" Content="5 Ring"/>
						</WrapPanel>
						<WrapPanel>
							<Border Style="{StaticResource QImgB}">
								<Image Source="/Resources/Images/Lp_Ikon.png"/>
							</Border>
							<Label Style="{StaticResource QuickLabel}" Content="6 Ring"/>
						</WrapPanel>
					</StackPanel>
				</ScrollViewer>
			</Grid>
		</Border>
		<Border Grid.Row="2" VerticalAlignment="Bottom"  Background="#15151C" Margin="10 10 10 10" CornerRadius="10" BorderThickness="1" BorderBrush="#222222">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="40"/>
					<RowDefinition Height="60"/>
				</Grid.RowDefinitions>
				<WrapPanel Margin="10 10 10 10">
					<TextBlock Text="" FontFamily="{StaticResource IconsFill}" Foreground="LimeGreen" FontSize="6" VerticalAlignment="Center"/>
					<TextBlock Text="Now Playing" Foreground="#CCCCCC" Margin="3 0 0 0"/>
				</WrapPanel>
				<WrapPanel Grid.Row="1" Margin="0 0 0 15">
					<Border Style="{StaticResource QImgB}" Margin="10 5 5 0">
						<Image Source="/Resources/Images/Lp_Ikon.png"/>
					</Border>
					<StackPanel>
						<Label Style="{StaticResource QuickLabel}" Content="Elden Ring"/>
						<WrapPanel Margin="0 -10 0 0">
							<Label Foreground="#CCCCCC" FontWeight="Light" FontSize="10" Content="Playing for:"/>
							<Label Foreground="#CCCCCC" FontWeight="Light" FontSize="10" Margin="-5 0 0 0" Content="45m"/>
						</WrapPanel>
					</StackPanel>
				</WrapPanel>
			</Grid>
		</Border>
	</Grid>
</UserControl>
