<Window x:Class="LaunchPad.View.ScanProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scanning for games..."
        Width="420" Height="140"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock x:Name="StatusText" Grid.Row="0" Text="Starting scan..."
                   TextWrapping="Wrap" Margin="0,0,0,12"/>
		<ProgressBar x:Name="ScanProgressBar" Grid.Row="1" IsIndeterminate="True" Height="18"/>
	</Grid>
</Window>